#!/usr/bin/python3 -S

import os
import sys
import time

def bold(s: str)  -> str: return '\033[37;1m' + s + '\033[m'  #]]
def green(s: str) -> str: return '\033[32m'   + s + '\033[m'  #]]

def read_fd(fd: int) -> str:
    return os.pread(fd, 4096, 0).strip().decode()

def read_file(path: str, default: str = 'N/A') -> str:
    try:
        fd = os.open(path, 0)
    except FileNotFoundError:
        return default
    try:
        return read_fd(fd)
    except OSError: # CPU possibly offline.
        return default
    finally:
        os.close(fd)

def write_file(path: str, s: str) -> str | None:
    try:
        fd = os.open(path, os.O_WRONLY)
    except FileNotFoundError:
        return 'No file'
    except PermissionError:
        return 'Need root'
    try:
        os.write(fd, s.encode())
    except OSError:
        return 'Bad input'
    finally:
        os.close(fd)

def align_fields(fields: list[str], align: list[int], sep: str) -> str:
    return sep.join([f'{x:{a}}' for x, a in zip(fields, align)])

def wrap_deduct_green(words: list[str], width: int) -> list[str]:
    line: list[str] = []
    line_w = 0
    lines: list[str] = []
    for word in words:
        w = len(word)
        if '\033' in word:
            w -= len(green(''))
        if line_w + w > width:
            lines.append(' '.join(line))
            line = []; line_w = 0
        line.append(word)
        line_w += w + 1

    lines.append(' '.join(line))
    return lines

def mark_unique_list(items: list[str], unique: set[str]) -> list[str]:
    items = items.copy()
    if len(unique) == 1:
        for i, item in enumerate(items):
            if item in unique:
                items[i] = f'[{green(item)}]'
                break
    return items

def mark_unique(items: list[str], unique: set[str]) -> str:
    return ' '.join(mark_unique_list(items, unique))

def mhz(khz: str) -> str:
    n, m = divmod(int(khz), 1000)
    return f'{n}.{m:0>3}'

def khz_from_mhz_str(mhz: str) -> int | None:
    a, _, b = mhz.partition('.')
    a = a.strip()
    b = b.strip()
    if not a: a = '0'
    if not b: b = '0'
    if a.isdecimal() and b.isdecimal():
        return int(a) * 1000 + int(f'{b:0<3}')
    return None

# =============================================================================

OUT = sys.stdout

TITLE_INDENT = 2
SEP          = '  '
CPU_PATH     = '/sys/devices/system/cpu'
CPU_INTEL_PSTATE_PATH = CPU_PATH + '/intel_pstate'
CPU_IDLE_PATH         = CPU_PATH + '/cpuidle'
ACPI_PATH    = '/sys/firmware/acpi'

def make_title(s: str) -> str:
    return bold(f'{TITLE_INDENT * "="}> {s}')

def write_cpu_intel_pstate() -> None:
    if not os.path.exists(CPU_INTEL_PSTATE_PATH):
        return

    hwp_dynboost =     read_file(CPU_INTEL_PSTATE_PATH + '/hwp_dynamic_boost')
    _max_pct     =     read_file(CPU_INTEL_PSTATE_PATH + '/max_perf_pct')
    _min_pct     =     read_file(CPU_INTEL_PSTATE_PATH + '/min_perf_pct')
    _no_turbo    = int(read_file(CPU_INTEL_PSTATE_PATH + '/no_turbo'))
    turbo        = str(int(not _no_turbo))
    status       =     read_file(CPU_INTEL_PSTATE_PATH + '/status')
    perf_range   = f'{_min_pct} - {_max_pct}'

    header = ['HWP DYN. BOOST', 'MIN/MAX PERF %', 'TURBO', 'STATUS']
    row    = [hwp_dynboost, perf_range, turbo, status]
    align  = [max(len(header[i]), len(x)) for i, x in enumerate(row)]

    OUT.write(f'{make_title(CPU_INTEL_PSTATE_PATH)}\n'
              f'{align_fields(header, align, SEP)}\n'
              f'{align_fields(row, align, SEP)}\n')

def write_cpu_idle() -> None:
    if not os.path.exists(CPU_IDLE_PATH):
        return

    govs_avail  =  read_file(CPU_IDLE_PATH + '/available_governors').split()
    govs_active = {read_file(CPU_IDLE_PATH + '/current_governor_ro')}
    driver      =  read_file(CPU_IDLE_PATH + '/current_driver')

    OUT.write(f'{make_title(CPU_IDLE_PATH)}\n'
              f'GOVERNORS = {mark_unique(govs_avail, govs_active)}\n'
              f'DRIVER    = {driver}\n')

class Cpus:
    CB_SCALING      = 2
    CB_GOVERNOR     = 3
    CB_EPP          = 4
    CB_EPB          = 5
    CB_ONLINE       = 6
    CB_AMD_BOOST    = 7

    __slots__ = ('amd', 'nr_cpus', 'govs_active', 'govs_avail',
                 'epps_active', 'epps_avail', 'active_callbacks')
    def refresh(self) -> tuple[str, list[str], list[int]]:
        amd = os.path.exists(CPU_PATH + '/amd_pstate')
        nr_cpus = os.sysconf('SC_NPROCESSORS_CONF')

        rows: list[list[str]] = []
        header = ['CPU', 'CPU MHz', 'SCALING MHz', 'GOVERNOR', 'EPP', 'EPB', 'ONLINE']
        if amd:
            header.extend(['BOOST', 'PREFCORE', 'RANK'])
        align = [len(x) for x in header]

        govs_active = set()
        epps_active = set()

        prefcore_ranks = []

        for i in range(nr_cpus):
            this          = f'{CPU_PATH}/cpu{i}/'
            governor      =     read_file(this + 'cpufreq/scaling_governor')
            _scaling_min  = mhz(read_file(this + 'cpufreq/scaling_min_freq', '0'))
            _scaling_max  = mhz(read_file(this + 'cpufreq/scaling_max_freq', '0'))
            _cpuinfo_min  = mhz(read_file(this + 'cpufreq/cpuinfo_min_freq', '0'))
            _cpuinfo_max  = mhz(read_file(this + 'cpufreq/cpuinfo_max_freq', '0'))
            epp           =     read_file(this + 'cpufreq/energy_performance_preference')
            epb           =     read_file(this + 'power/energy_perf_bias')
            online        =     read_file(this + 'online')
            cpu           = str(i)
            cpu_range     = f'{_cpuinfo_min:>4} - {_cpuinfo_max:<4}'
            scaling_range = f'{_scaling_min:>4} - {_scaling_max:<4}'

            row = [cpu, cpu_range, scaling_range, governor, epp, epb, online]
            if amd:
                boost    = read_file(this + 'cpufreq/boost')
                prefcore = read_file(this + 'cpufreq/amd_pstate_hw_prefcore')
                rank     = read_file(this + 'cpufreq/amd_pstate_prefcore_ranking', '-1')
                prefcore_ranks.append(int(rank))
                row.extend([boost, prefcore, rank])

            for i, x in enumerate(row):
                align[i] = max(align[i], len(x))

            rows.append(row)

            govs_active.add(governor)
            epps_active.add(epp)

        if amd:
            RANK_IDX = -1
            ranks = {}
            # This could even be a one-liner: dict(map(reverse, enumerate(...
            for i, r in enumerate(sorted(set(prefcore_ranks), reverse=True), 1):
                ranks[r] = str(i)
            for i, row in enumerate(rows):
                rows[i][RANK_IDX] = ranks[int(row[RANK_IDX])]

        govs_avail = \
            read_file(CPU_PATH + '/cpu0/cpufreq/scaling_available_governors').split()
        epps_avail = \
            read_file(CPU_PATH + '/cpu0/cpufreq/energy_performance_available_preferences').split()

        self.amd         = amd
        self.nr_cpus     = nr_cpus
        self.govs_active = govs_active
        self.govs_avail  = govs_avail
        self.epps_active = epps_active
        self.epps_avail  = epps_avail
        self.active_callbacks = [
            Cpus.CB_SCALING,
            Cpus.CB_GOVERNOR,
            Cpus.CB_EPP,
            Cpus.CB_EPB,
            Cpus.CB_ONLINE,
        ]
        if amd:
            self.active_callbacks.append(Cpus.CB_AMD_BOOST)

        return (align_fields(header, align, SEP),
               [align_fields(x, align, SEP) for x in rows],
               align)

    def update_cell(self, cy: int, cx: int, text: str) -> str | None:
        text = text.strip()
        this = f'{CPU_PATH}/cpu{cy}/'
        if cx == Cpus.CB_SCALING:
            lo, _, hi = text.partition('-')
            lo_khz = hi_khz = khz_from_mhz_str(lo)
            if hi:
                hi_khz = khz_from_mhz_str(hi)
            if lo_khz is None or hi_khz is None:
                return 'Bad input'
            return (write_file(this + 'cpufreq/scaling_min_freq', str(lo_khz)) or
                    write_file(this + 'cpufreq/scaling_max_freq', str(hi_khz)))
        if cx == Cpus.CB_GOVERNOR:
            return write_file(this + 'cpufreq/scaling_governor', text)
        if cx == Cpus.CB_EPP:
            return write_file(this + 'cpufreq/energy_performance_preference', text)
        if cx == Cpus.CB_EPB:
            return write_file(this + 'cpufreq/energy_perf_bias', text)
        if cx == Cpus.CB_ONLINE:
            if text not in {'0', '1'}:
                return 'Bad input'
            return write_file(this + 'online', text)
        if cx == Cpus.CB_AMD_BOOST:
            if text not in {'0', '1'}:
                return 'Bad input'
            return write_file(this + 'cpufreq/boost', text)
        return 'Inactive'

    def refresh_and_write(self) -> None:
        header, lines, _ = self.refresh()

        indent = len('GOVERNORS = ') * ' '
        wrap_width = len(header) - len(indent)

        gov_lines = wrap_deduct_green(
            mark_unique_list(self.govs_avail, self.govs_active), wrap_width)
        epp_lines = wrap_deduct_green(
            mark_unique_list(self.epps_avail, self.epps_active), wrap_width)

        nl = '\n'
        nl_indent = '\n' + indent
        OUT.write(f'{make_title(CPU_PATH)}\n'
                  f'{header}\n'
                  f'{nl.join(lines)}\n\n'
                  f'GOVERNORS = {nl_indent.join(gov_lines)}\n'
                  f'EPPS      = {nl_indent.join(epp_lines)}\n')

def write_acpi_profiles() -> None:
    if not os.path.exists(ACPI_PATH):
        return

    avail  =  read_file(ACPI_PATH + '/platform_profile_choices').split()
    active = {read_file(ACPI_PATH + '/platform_profile')}

    OUT.write(f'{make_title(ACPI_PATH)}\n'
              f'PROFILES = {mark_unique(avail, active)}\n')

def monitor_cpu_freq(
        nr_cpus: int,
        interval_ms: int,
        fallback_mhz: int,
        avg_win_size: int
) -> None:
    assert (lambda x: x and x & (x - 1) == 0)(avg_win_size)

    cpu_fds = []
    for i in range(nr_cpus):
        fd = os.open(f'{CPU_PATH}/cpu{i}/cpufreq/scaling_cur_freq', 0)
        cpu_fds.append(fd)
        OUT.write(f'CPU{i:<3}')
    OUT.write(f' AVG{avg_win_size:<3}MIN   MAX\n')

    interval_sec = interval_ms / 1000
    freq_min = 1000 * 1000
    freq_max = 0

    avg_win_mask = avg_win_size - 1
    avg_win = [0] * avg_win_size
    i = 0

    def read_fd_nofail(fd: int) -> str:
        try:
            return read_fd(fd)
        except OSError:
            return '0'

    while True:
        s = ''
        t = 0
        for fd in cpu_fds:
            mhz = int(read_fd_nofail(fd)) // 1000
            if   mhz < freq_min: freq_min = mhz
            elif mhz > freq_max: freq_max = mhz
            if mhz == fallback_mhz:
                s += '.     '
            else:
                s += f'{mhz:<6}'
            t += mhz

        avg_win[i] = t // nr_cpus
        i = (i + 1) & avg_win_mask

        tw = 0
        for j in range(avg_win_size):
            tw += avg_win[(i + j) & avg_win_mask] << j
        freq_avg = tw // ((1 << avg_win_size) - 1)

        OUT.write(f'{s}~{freq_avg:<4} >{freq_min:<4} <{freq_max:<4}\n')
        time.sleep(interval_sec)

def usage() -> int:
    OUT.write(
        f'usage: {os.path.basename(sys.argv[0])} [[--fallback-mhz=800] <interval_ms>] [-i]\n'
        '  --fallback-mhz   After the CPU is idle for 20ms the kernel decides against\n'
        '                   sending an IPI to query current CPU frequency and instead\n'
        '                   retrieves a cpufreq driver-dependent per-CPU policy value\n'
        '                   as fallback. This is a good indication the CPU is idling.\n'
        '                   Set this option to the apparent fallback value -- usually\n'
        '                   the lowest P-State frequency -- to visually differentiate\n'
        '                   potential fallback values from actual frequency readouts.\n'
        '\n'
        '  -i               Interactive edit mode.\n'
    )
    return 2

def main() -> int:
    interval_ms  = 0
    fallback_mhz = 800
    interactive  = False

    if len(sys.argv) > 1:
        get_fallback_mhz = False
        for arg in sys.argv[1:]:
            arg, _, value = arg.partition('=')
            if get_fallback_mhz:
                get_fallback_mhz = False
                if arg.isdecimal():
                    fallback_mhz = int(arg)
                    continue
                return usage()

            if arg == '-i':
                interactive = True
            elif arg == '--fallback-mhz':
                if value.isdecimal():
                    fallback_mhz = int(value)
                else:
                    get_fallback_mhz = True
            elif arg.isdecimal():
                if not interval_ms:
                    interval_ms = int(arg)
            else:
                return usage()

    cpus = Cpus()

    if interactive:
        import libcmenu
        header, lines, align = cpus.refresh()
        opts = libcmenu.Options()
        opts.sep = SEP
        opts.active_cb = tuple(cpus.active_callbacks)
        opts.cursor_ul = (0, libcmenu.curses.A_UNDERLINE)
        opts.select_ul = (0, libcmenu.curses.A_STANDOUT)
        opts.x_keep = align[0] + len(SEP)
        return libcmenu.curses_menu(header, lines, align, opts, cpus)

    write_cpu_intel_pstate()
    cpus.refresh_and_write()
    write_cpu_idle()
    write_acpi_profiles()
    if interval_ms:
        monitor_cpu_freq(cpus.nr_cpus, interval_ms, fallback_mhz, 8)

    return 0

if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        pass
